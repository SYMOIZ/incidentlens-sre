# SQLite database path (relative to cwd or absolute)
INCIDENTLENS_DB_PATH=incidentlens.db

# Detection thresholds
INCIDENTLENS_ERROR_REPEAT_THRESHOLD=3
INCIDENTLENS_ERROR_WINDOW_SECONDS=300
INCIDENTLENS_BASELINE_MULTIPLIER=3.0
INCIDENTLENS_BASELINE_MIN_SAMPLES=20

# API
INCIDENTLENS_HOST=0.0.0.0
INCIDENTLENS_PORT=8000
